# Copy this file to .env and fill it in. .env is git-ignored; never commit it or paste it anywhere.

# Your domain. Point it at the server's IP address in DNS before the first start: Caddy asks Let's Encrypt for the
# certificate as soon as it starts, and that only works once the name resolves to this machine.
DOMAIN=looks.example.com

# The only required secret. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Web Push (optional). Leave both keys empty and the app never offers notifications. Generate a pair with the app's
# --vapid command (see DEPLOY.md, "Push notifications"), paste them here, restart.
Push__PublicKey=
Push__PrivateKey=
Push__Subject=mailto:you@example.com

# Moderators. Sign up in the app FIRST, then put that handle here and `docker compose up -d`: at start the app promotes
# the existing account with a listed handle (case-insensitive; it never demotes), and a listed handle can no longer be
# signed up by anyone, so listing it before you sign up locks you out of it. Add Admin__Handles__1, __2 for more people,
# each once they have an account. Or, at any time and without a restart:
#   docker compose exec app dotnet FitCheck.Api.dll --admin <handle>
# (--unadmin revokes; remove the line here too, or the next restart promotes it again). See DEPLOY.md, step 7.
# Admin__Handles__0=yourhandle

# Account recovery by email (optional). Mail is on when Host and From are set; see DEPLOY.md, "Email for account
# recovery", for the exact lines for Resend, Postmark and Gmail. The password is a secret. PublicOrigin is REQUIRED on
# a server once mail is on: links are built from it and never from a request's Host header, so without it no
# confirmation or reset link goes out on anything but localhost.
# Email__Host=smtp.resend.com
# Email__Port=587
# Email__User=resend
# Email__Password=
# Email__From=OREVOSH <hello@looks.example.com>
# Email__PublicOrigin=https://looks.example.com

# Plans (optional; the defaults are the pilot's). Every check is a paid model call: a visitor gets GuestChecksPerDay free
# checks with no account (per guest cookie and per address a day; 0 turns guests off), a free account FreeChecksPerDay,
# Pro ProChecksPerDay (never above Limits__ChecksPerDay, 30). ProPriceText is what the Pro page shows as the price.
# Plans__FreeChecksPerDay=3
# Plans__ProChecksPerDay=30
# Plans__GuestChecksPerDay=1
# Plans__ProPriceText=₪19 / month
# Plans__CompareNeedsPro=false

# Billing (optional). Leave the provider at "manual" and grant Pro with
#   docker compose exec app dotnet FitCheck.Api.dll --pro <handle> <months|off>
# Switch to "stripe" only with a price and a webhook you have tested in test mode (DEPLOY.md, "Plans and billing"): the
# webhook endpoint is https://$DOMAIN/api/billing/webhook with checkout.session.completed, invoice.paid and
# customer.subscription.deleted. The three Stripe values are secrets.
# Billing__Provider=manual
# Billing__StripeSecretKey=
# Billing__StripePriceId=
# Billing__StripeWebhookSecret=
# Billing__PublicOrigin=https://looks.example.com
