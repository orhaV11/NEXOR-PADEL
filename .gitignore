# .NET
bin/
obj/
*.user
*.swp
.vs/
.idea/

# Local data — never commit a database, photos, or local config
*.db
*.db-shm
*.db-wal
storage/
appsettings.Development.json

# The copy the app writes next to a pilot database before upgrading it, and backups (tools/backup.sh, --backup)
*.bak-*
*.db.bak-*
backups/

# Secrets
.env
.env.*
!.env.example

# Test output
TestResults/

# Python bytecode
__pycache__/
*.pyc

# Workflow worktrees and local agent state
.claude/
keys/

# Calibration reports (tools/eval/calibrate.ps1): they carry the account's handle and the stylist's tips, and the
# verdict line is what gets pasted. The folder itself stays.
tools/eval/reports/*
!tools/eval/reports/.gitkeep
