{
  "ConnectionStrings": {
    "Default": "Data Source=orevosh.db"
  },
  "Anthropic": {
    "Model": "claude-sonnet-5",
    "MaxTokens": 1200,
    "BaseUrl": "https://api.anthropic.com"
  },
  "Storage": {
    "Root": "storage",
    "MaxImageBytes": 6291456
  },
  "Limits": {
    "ChecksPerDay": 30,
    "ChecksPerDayGlobal": 1000,
    "SignupsPerHourPerIp": 50
  },
  "Plans": {
    "GuestAttemptsPerDay": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
