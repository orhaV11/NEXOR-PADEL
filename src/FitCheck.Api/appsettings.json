{
  "ConnectionStrings": {
    "Default": "Data Source=orevosh.db"
  },
  "Anthropic": {
    "Model": "claude-sonnet-5",
    "MaxTokens": 1200,
    "BaseUrl": "https://api.anthropic.com"
  },
  "Storage": {
    "Root": "storage",
    "MaxImageBytes": 6291456
  },
  "Limits": {
    "ChecksPerDay": 30,
    "ChecksPerDayGlobal": 1000,
    "SignupsPerHourPerIp": 50
  },
  "Plans": {
    "GuestAttemptsPerDay": 20,
    "NoOutfitForgivenPerDay": 3
  },
  "Languages": {
    "Enabled": [ "en", "he" ]
  },
  "Board": {
    "WeekStartsOn": "Sunday",
    "TimeZone": "Asia/Jerusalem",
    "MinChecksToCount": 1,
    "MaxPerFirerPerAuthor": 3,
    "NewAccountDays": 2,
    "Size": 10,
    "RisingDays": 30,
    "CacheSeconds": 60
  },
  "Affiliate": {
    "Disclosure": true,
    "Hosts": {}
  },
  "Digest": {
    "Enabled": true,
    "Hour": 9
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
